# Garage's minimal boot settings - loaded first by subghz_txrx_alloc().
# Just 433.92MHz - the frequency/preset list is expanded on demand by
# subghz_txrx_ensure_full_settings_loaded() (see setting_garage_full and the
# comment above that function in helpers/subghz_txrx.c) so a plain Read
# never pays for frequency/preset data most sessions never touch.
Filetype: Flipper SubGhz Setting File
Version: 1
Add_standard_frequencies: false

Default_frequency: 433920000

Frequency: 433920000

# Must have at least one entry or subghz_setting_load() treats the whole
# load as failed and falls back to loading everything (defeats the point).
Hopper_frequency: 433920000
